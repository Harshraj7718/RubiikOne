# Copy to .env and fill in. .env is ignored by git; this example file is safe to commit.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database the store uses on that cluster
MONGODB_DB=rubiik

# Admin dashboard (/admin) login — choose your own; use a long, random password.
ADMIN_USERNAME=rubiik-admin
ADMIN_PASSWORD=

# Optional: real payments (without these the payment step runs in test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: key for serial check codes (otherwise one is generated and stored in the database)
SERIAL_SECRET=

# Email from support@rubiikone.com: the mailbox's SMTP settings (Google Workspace: smtp.gmail.com with an
# app password; Zoho: smtp.zoho.in; Hostinger: smtp.hostinger.com). Without them, emails are printed
# to the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=support@rubiikone.com
SMTP_PASS=
MAIL_FROM=RUBIIK <support@rubiikone.com>

# Public address of the site, used for links in emails (e.g. https://rubiikone.com)
SITE_URL=

# Optional: a different Meta Pixel ID (RUBIIK's own, 2624778291293532, is built in; see vite.config.js).
VITE_META_PIXEL_ID=
